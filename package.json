{
  "name": "ask-edgeorgie-mcp",
  "version": "1.0.0",
  "description": "MCP server that lets an agent ask real, grounded, cited questions about Edwin Jorge (edgeorgie) — his work experience, shipped projects, and skills — sourced from his actual resume and project evidence, never hallucinated.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "ask-edgeorgie-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-data",
    "copy-data": "mkdir -p dist/data && cp data/*.txt data/*.md dist/data/ 2>/dev/null || true",
    "start": "node dist/server.js",
    "start:http": "node dist/http-server.js",
    "dev": "tsx src/server.ts",
    "dev:http": "tsx src/http-server.ts",
    "pretest": "npm run build",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgeorgie/ask-edgeorgie-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-callable",
    "resume",
    "candidate",
    "rag"
  ],
  "author": "edgeorgie",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/edgeorgie/ask-edgeorgie-mcp/issues"
  },
  "homepage": "https://github.com/edgeorgie/ask-edgeorgie-mcp#readme",
  "dependencies": {
    "@edgeorgie/retrieval-core": "github:edgeorgie/retrieval-core",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@vercel/node": "^23.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
